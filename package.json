{
  "name": "ai-cut",
  "private": true,
  "version": "0.1.38",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "Drama Flow Studio는 AI 숏드라마와 영상 워크플로를 제작하는 오픈소스 워크스페이스입니다.",
  "homepage": "https://github.com/JerrIsTheBesta/AI-Short-Drama-Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/JerrIsTheBesta/AI-Short-Drama-Studio.git"
  },
  "keywords": [
    "korean-localization",
    "ai-workspace",
    "video-production",
    "ai-short-drama",
    "ai-video-generator",
    "video-workflow",
    "storyboard",
    "image-to-video"
  ],
  "scripts": {
    "dev": "vite",
    "web": "vite --mode web",
    "security:check": "node scripts/assert-source-clean.mjs",
    "build": "node scripts/assert-source-clean.mjs && vue-tsc --noEmit && vite build && node scripts/assert-pack-clean.mjs",
    "electron:build": "node scripts/assert-source-clean.mjs && vue-tsc --noEmit && vite build && node scripts/assert-pack-clean.mjs && node scripts/pack-electron.mjs",
    "preview": "vite preview --host",
    "type-check": "vue-tsc --noEmit",
    "test:openai-analysis": "node --test scripts/test-openai-analysis.mjs",
    "test:openai-tts": "node --test scripts/test-openai-tts.mjs",
    "test:openai-image": "node --test scripts/test-openai-image.mjs",
    "test:draw-things": "node --test scripts/test-draw-things.mjs",
    "test:agent": "node scripts/test-agent-redo.mjs",
    "test:comfy": "node scripts/test-comfy-reference-slots.mjs",
    "test:continuous": "node scripts/test-continuous-capture.mjs",
    "test:enter": "node scripts/test-enter-shortcut.mjs",
    "test:default-names": "node --test scripts/test-default-names.mjs",
    "diagnose:storyboard": "node scripts/diagnose-storyboard-llm.mjs"
  },
  "build": {
    "appId": "com.aicuts.desktop",
    "productName": "Drama Flow Studio",
    "icon": "logo.ico",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/.env",
      "!**/.env.*",
      "!**/*.local"
    ],
    "extraResources": [
      {
        "from": "logo.ico",
        "to": "logo.ico"
      },
      {
        "from": "logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "icon": "logo.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "logo.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "installerHeaderIcon": "logo.ico"
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@grpc/grpc-js": "^1.14.7",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ai": "^7.0.172",
    "flatbuffers": "^25.9.23",
    "naive-ui": "^2.38.2",
    "pinia": "^2.1.7",
    "protobufjs": "^7.6.6",
    "vue": "^3.4.27",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.3.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^1.1.1",
    "vue-tsc": "^2.0.19"
  }
}
